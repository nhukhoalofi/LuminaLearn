GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_LANGUAGE=vi
TTS_PROVIDER=gemini

# Gemini API Free Tier Quota & Request Budgets (per job)
GEMINI_MAX_REQUESTS_PER_JOB=4
GEMINI_TTS_MAX_REQUESTS_PER_JOB=5

# Localhost vs. Public Deployment Security Boundary
# Public deployment is disabled by default unless LUMINA_PUBLIC_DEPLOYMENT=true and LUMINA_API_AUTH_TOKEN is set.
# Local demo is a single-user trust domain. Development mode enables it automatically;
# set this only for an intentionally loopback-bound production demo.
LUMINA_LOCAL_DEMO=false
LUMINA_PUBLIC_DEPLOYMENT=false
LUMINA_API_AUTH_TOKEN=
LUMINA_MAX_PENDING_JOBS=3

# Google Cloud Text-to-Speech uses Application Default Credentials, not GEMINI_API_KEY.
# Keep service-account files outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_TTS_VOICE=vi-VN-Neural2-A
# Use only when ADC is available through another mechanism such as gcloud ADC.
GOOGLE_TTS_ENABLED=false
