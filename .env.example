GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Text-to-Speech uses Application Default Credentials, not GEMINI_API_KEY.
# Keep service-account files outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_TTS_VOICE=vi-VN-Neural2-A
# Use only when ADC is available through another mechanism such as gcloud ADC.
GOOGLE_TTS_ENABLED=false

