{
  "name": "@luminalearn/hybrid-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Server-only hybrid Manim and Remotion orchestration",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "render": "tsx src/cli.ts",
    "smoke:gemini-tts": "tsx src/gemini-tts-smoke.ts",
    "preflight:gemini-tts": "tsx src/gemini-tts-preflight.ts",
    "acceptance": "tsx src/render-v3-phase11-acceptance.ts --mode=offline",
    "acceptance:offline": "tsx src/render-v3-phase11-acceptance.ts --mode=offline",
    "acceptance:real-tts": "tsx src/render-v3-phase11-acceptance.ts --mode=real-tts"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "7.1.1",
    "@google/genai": "^3.0.0",
    "@luminalearn/agent": "workspace:*",
    "@luminalearn/scene-schema": "workspace:*",
    "dotenv": "16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
