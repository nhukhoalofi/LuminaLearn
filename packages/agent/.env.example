GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_LANGUAGE=vi
TTS_PROVIDER=gemini

# Optional server-side Codex planning agent (Responses API).
OPENAI_API_KEY=
OPENAI_CODEX_MODEL=gpt-5.3-codex
OPENAI_CODEX_MAX_REQUESTS_PER_JOB=2
OPENAI_CODEX_TIMEOUT_MS=60000
OPENAI_CODEX_MAX_OUTPUT_TOKENS=12000

