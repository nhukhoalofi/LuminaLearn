{
  "name": "luminalearn-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LuminaLearn Monorepo - Nền tảng học tập trực quan và tạo video khoa học thông minh",
  "scripts": {
    "dev:web": "pnpm --filter @luminalearn/web dev",
    "dev:worker": "pnpm --filter @luminalearn/worker dev",
    "render:worker": "pnpm --filter @luminalearn/worker render",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:math-engine": "node scripts/test-math-engine.mjs",
    "phase3:mock": "pnpm --filter @luminalearn/agent generate",
    "phase3:render": "pnpm --filter @luminalearn/agent generate -- --render",
    "hybrid:render": "pnpm --filter @luminalearn/hybrid-renderer render",
    "acceptance": "pnpm --filter @luminalearn/hybrid-renderer acceptance",
    "acceptance:offline": "pnpm --filter @luminalearn/hybrid-renderer acceptance:offline",
    "acceptance:real-tts": "pnpm --filter @luminalearn/hybrid-renderer acceptance:real-tts"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "verifyDepsBeforeRun": false
  }
}
